{
  "base": "safe-landscape.json",
  "override": {
    "viewport": {
      "start": { "width": 360, "height": 640, "device_pixel_ratio": 1, "scroll_x": 0, "scroll_y": 0 },
      "end": { "width": 360, "height": 640, "device_pixel_ratio": 1, "scroll_x": 0, "scroll_y": 0 }
    },
    "video_element": {
      "start": { "x": 0, "y": 20, "width": 360, "height": 600, "top": 20, "right": 360, "bottom": 620, "left": 0 },
      "end": { "x": 0, "y": 20, "width": 360, "height": 600, "top": 20, "right": 360, "bottom": 620, "left": 0 }
    },
    "intrinsic_video": { "width": 1080, "height": 1920 },
    "computed_style": { "object_fit": "contain", "object_position": "50% 50%" },
    "capture_track": {
      "mime_type": "video/webm;codecs=vp9,opus",
      "audio_track_count": 1,
      "video_track_count": 1,
      "tracks": [
        { "kind": "audio", "settings": { "sampleRate": 48000, "channelCount": 2 } },
        { "kind": "video", "settings": { "width": 360, "height": 640, "frameRate": 30 } }
      ],
      "loopback_enabled": true
    }
  },
  "expected_result": "accept"
}
