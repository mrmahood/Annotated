NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Staging-only X OAuth. Enabled automatically when NEXT_PUBLIC_SUPABASE_URL is
# exactly https://nkkunkwirvfwhmpwonqz.supabase.co. Production URLs stay fail-closed.
# Set to 0 to hide X on a Staging-pointed build without a code change.
# NEXT_PUBLIC_ANNOTATED_STAGING_X_WEB_AUTH=1
# Phase F Matt-only moderation allowlist (F2 claim review, F3 hide/unhide, F4 media-only withdrawal, F5 full-record remove).
# Also gates the /ops operator console. Server-only; never prefix with NEXT_PUBLIC_.
# Leave empty to fail closed (API 500; /ops notFound). Set profile UUID and/or email;
# never accept operator id from clients.
# AI receipts assist. Unset hides the side-panel control. Server-only; never prefix with NEXT_PUBLIC_.
# Vercel AI Gateway key. Optional model override defaults to openai/gpt-4o-mini.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=
ANNOTATED_MODERATION_OPERATOR_IDS=
ANNOTATED_MODERATION_OPERATOR_EMAILS=
# Upload-triggered media dispatch. Server-only. Leave unset locally.
# Set to "on" only on a hosted web deployment, and set the matching private key
# for annotated-upload-dispatch@annotated-504301.iam.gserviceaccount.com.
# The job is chosen from NEXT_PUBLIC_SUPABASE_URL. A failed trigger does not fail the upload.
# Never commit the private key. Store newlines as \n.
# ANNOTATED_MEDIA_DISPATCH_TRIGGER=on
# ANNOTATED_DISPATCH_TRIGGER_PRIVATE_KEY=
